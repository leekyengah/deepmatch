{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://datingvn.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://zzqpvjdyvjarpphqhaze.supabase.co",
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "premium_monthly"
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://datingvn.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://zzqpvjdyvjarpphqhaze.supabase.co",
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "premium_monthly",
        "EXPO_NO_TELEMETRY": "1"
      }
    },
    "preview-store": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://datingvn.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://zzqpvjdyvjarpphqhaze.supabase.co",
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "premium_monthly"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://deepmatch-prod.vercel.app",
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "premium_monthly"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_ASC_APP_ID"
      }
    }
  }
}
