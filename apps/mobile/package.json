{
  "name": "@deepmatch/mobile",
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "go": "expo start --go --lan",
    "go:clear": "expo start --go --lan --clear",
    "go:tunnel": "expo start --go --tunnel",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eas:preview": "eas build --platform ios --profile preview",
    "eas:preview:android": "eas build --platform android --profile preview",
    "eas:preview:ios-sim": "eas build --platform ios --profile preview-simulator",
    "eas:production": "eas build --platform ios --profile production",
    "doctor": "npx expo-doctor",
    "preflight:preview": "npx expo-doctor && npm run typecheck",
    "eas-build-post-install": "node ../../scripts/link-mobile-expo-modules.mjs"
  },
  "dependencies": {
    "@deepmatch/design-tokens": "*",
    "@deepmatch/i18n": "*",
    "@deepmatch/shared": "*",
    "@expo/json-file": "^11.0.1",
    "@supabase/supabase-js": "^2.47.10",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    },
    "autolinking": {
      "exclude": [
        "react-native-iap"
      ]
    },
    "doctor": {
      "duplicateDependenciesCheck": {
        "enabled": false
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
