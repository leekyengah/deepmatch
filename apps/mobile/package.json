{
  "name": "@deepmatch/mobile",
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "go": "expo start --lan --clear",
    "typecheck": "tsc -p tsconfig.json --noEmit",
