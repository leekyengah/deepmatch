{
  "name": "@deepmatch/qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepMatch Independent QA adapter — catalog, runners, staging allowlist",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "deepmatch-qa": "./bin/deepmatch-qa.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "qa": "tsx src/cli.ts"
  },
  "dependencies": {
    "@tradingbase/qa-core": "*",
    "@tradingbase/qa-adapters": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
