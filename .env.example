# DeepMatch — never commit real secrets
# Copy to .env.local for apps; use separate staging vs prod Supabase projects

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer legacy anon JWT, or new publishable key (either works in clients)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin founder (comma-separated). DB admin_roles.owner is source of truth;
# these emails also pass the admin app gate for bootstrap.
ADMIN_OWNER_EMAILS=leekyengah@gmail.com
ADMIN_OWNER_EMAIL=leekyengah@gmail.com

NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Feature flags (local overrides; DB flags win in staging/prod)
FF_MATCHING=true
FF_CHAT=true
FF_MEDIA_UPLOAD=true
FF_CONCIERGE=false
FF_DISCOVERY=true
FF_PREMIUM=true
FF_BILLING=true
FF_LIFESTYLE=true
FF_AI=true

# AI Gateway — DECISION-AI-01 C: stub default; set AI_ADAPTER=openai + key to enable LLM
AI_ADAPTER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Manual bank transfer (public receiving account)
NEXT_PUBLIC_PREMIUM_PRICE_VND=99000
NEXT_PUBLIC_BILLING_BANK_NAME=HD Bank
NEXT_PUBLIC_BILLING_BANK_ACCOUNT=0964859937
NEXT_PUBLIC_BILLING_BANK_HOLDER=NGUYEN THI TUYET NHUNG

# Age policy
MIN_AGE=18

# Apple IAP (iOS App Store)
APPLE_BUNDLE_ID=com.datingvn.deepmatch
APPLE_IAP_PRODUCT_ID=premium_monthly

# Observability (optional — leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
